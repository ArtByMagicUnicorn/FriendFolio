@page
@model IndexModel

@{
    ViewData["Title"] = "Start";
}

<section class="home-hero">
    <div class="home-hero-content">
        <p class="eyebrow">FriendFolio</p>
        <h1>Skapa en digital vänbok fylld med minnen.</h1>
        <p>
            Bjud in vänner, familj, kollegor eller gäster att svara på personliga frågor.
            Samla hälsningar, berättelser och små ögonblick på ett ställe.
        </p>
        <p class="home-memory-line">
            Små minnen blir stora när någon sparar dem.
        </p>

        <div class="form-actions">
            <a asp-page="/Books/Create" class="btn btn-primary">Skapa en bok</a>
            <a asp-page="/Books/Index" class="btn btn-outline-secondary">Mina böcker</a>
        </div>
    </div>

    <div class="home-hero-brand">
        <img src="~/images/brand/friendfolio-logo.png"
             alt="FriendFolio - Mina vänner. Våra berättelser." />
    </div>


</section>

<section class="daily-question-card">
    <p class="eyebrow">Dagens fråga</p>
    <h2>@Model.DailyQuestion</h2>
    <p>
        En vänbok börjar ofta med en enkel fråga, och ibland räcker det för att väcka
        ett helt minne.
    </p>
</section>

<section class="content-panel">
    <div class="section-heading">
        <p class="eyebrow">Så funkar det</p>
        <h2>Från tom bok till sparade minnen</h2>
    </div>

    <div class="steps-grid">
        <article class="step-card">
            <span>1</span>
            <h3>Skapa en bok</h3>
            <p>Ge boken ett namn och börja med färdiga frågor eller egna funderingar.</p>
        </article>

        <article class="step-card">
            <span>2</span>
            <h3>Dela länken</h3>
            <p>Skicka den privata länken till de personer du vill samla svar från.</p>
        </article>

        <article class="step-card">
            <span>3</span>
            <h3>Spara berättelserna</h3>
            <p>Läs uppslagen, minns tillsammans och bygg en bok som går att återvända till.</p>
        </article>
    </div>
</section>

<section class="content-panel">
    <div class="section-heading">
        <p class="eyebrow">Passar för</p>
        <h2>Små och stora tillfällen</h2>
    </div>

    <div class="occasion-grid">
        <article class="occasion-card">
            <h3>Födelsedagar</h3>
            <p>Samla hälsningar, minnen och roliga svar till någon som ska firas.</p>
        </article>

        <article class="occasion-card">
            <h3>Vänner & familj</h3>
            <p>Skapa en personlig bok med svar från människorna som betyder mest.</p>
        </article>

        <article class="occasion-card">
            <h3>Kollegor</h3>
            <p>Gör en varm avtackning, kickoff-bok eller grupphälsning.</p>
        </article>

        <article class="occasion-card">
            <h3>Skola & grupper</h3>
            <p>Samla klassminnen, föreningshälsningar eller svar från ett gemensamt projekt.</p>
        </article>
    </div>
</section>