@page
@model Friendfolio.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Logga in";
}

<section class="page-header">
    <p class="eyebrow">Konto</p>
    <h1>Logga in</h1>
    <p>Logga in med Google för att skapa och hantera dina vänböcker.</p>
</section>

<section class="form-card">
