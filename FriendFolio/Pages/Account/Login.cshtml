@page
@model Friendfolio.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Logga in";
}

<section class="login-page">
    <div class="login-copy">
        <p class="eyebrow">Konto</p>
        <h1>Logga in och hantera dina vänböcker.</h1>
        <p>
            Skapa böcker, lägg till frågor och samla svar från de personer du bjuder in.
            Gäster som svarar via en delningslänk behöver inget konto.
        </p>
    </div>

    <section class="login-card">
        <p class="eyebrow">FriendFolio</p>
        <h2>Fortsätt med Google</h2>
        <p>
            Din inloggning används för att koppla dina böcker till dig.
        </p>

        <form method="post">
            <button type="submit" class="btn btn-primary login-button google-login-button">
                <span class="google-icon" aria-hidden="true">G</span>
                <span>Logga in med Google</span>
            </button>
        </form>

        <p class="login-note">
            Du skickas vidare till Google och kommer sedan tillbaka till FriendFolio.
            <a asp-page="/Privacy">Läs mer om hur FriendFolio hanterar data.</a>
        </p>
    </section>
</section>