@page
@model Friendfolio.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Mina böcker";
}

<section class="page-header">
    <p class="eyebrow">Friendfolio</p>
    <h1>Mina böcker</h1>
    <p>Skapa och hantera digitala vänböcker för vänner, grupper och minnen.</p>

    <a asp-page="./Create" class="btn btn-primary">Skapa bok</a>
</section>


@if (!Model.MemoryBooks.Any())
{
    <section class="empty-state empty-books-state">
        <img src="~/images/friendfolio-empty.png"
             alt="Illustration av en öppen vänbok"
             class="empty-state-image" />


        <a asp-page="/Books/Create" class="btn btn-primary">
            Skapa vänbok
        </a>
    </section>
}
else
{
    <section class="book-grid">
        @foreach (var book in Model.MemoryBooks)
        {
            <article class="book-card">
                <div class="book-card-header">
                    <div>
                        <p class="eyebrow">Vänbok</p>
                        <h2>@book.Title</h2>
                    </div>

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@book.Id"
                          class="delete-book-form">
                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm"
                                onclick="return confirm('Vill du ta bort hela vänboken? Alla frågor och svar tas bort.');">
                            Ta bort
                        </button>
                    </form>
                </div>

                @if (!string.IsNullOrWhiteSpace(book.Description))
                {
                    <p>@book.Description</p>
                }

                <span class="book-meta">
                    Skapad @book.CreatedAt.ToString("yyyy-MM-dd")
                </span>

                <div class="book-stats">
                    <span class="book-stat-chip book-stat-questions">
                        @book.Questions.Count frågor
                    </span>

                    <span class="book-stat-chip book-stat-entries">
                        @book.Entries.Count uppslag
                    </span>
                </div>

                <div class="book-actions">
                    <a asp-page="./Details"
                       asp-route-id="@book.Id"
                       class="btn btn-primary">
                        Öppna bok
                    </a>
                </div>
            </article>
        }
    </section>
}