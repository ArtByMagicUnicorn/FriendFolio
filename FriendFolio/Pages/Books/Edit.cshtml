@page "{id:int}"
@model Friendfolio.Pages.Books.EditModel

@{
    ViewData["Title"] = "Redigera bok";
}

<section class="page-header">
    <p class="eyebrow">Vänbok</p>
    <h1>Redigera bok</h1>
    <p>Uppdatera titel och beskrivning för din vänbok.</p>
</section>

<section class="form-card">
    <form method="post">
            <input type="hidden" asp-for="MemoryBook.Id" />
        <div class="mb-3">
            <label asp-for="MemoryBook.Title" class="form-label">Titel</label>
            <input asp-for="MemoryBook.Title"
                   class="form-control" />
            <span asp-validation-for="MemoryBook.Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MemoryBook.Description" class="form-label">Beskrivning</label>
            <textarea asp-for="MemoryBook.Description"
                      class="form-control"
                      rows="4"></textarea>
            <span asp-validation-for="MemoryBook.Description" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Spara ändringar</button>

            <a asp-page="./Details"
               asp-route-id="@Model.MemoryBook.Id"
               class="btn btn-outline-secondary">
                Avbryt
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}