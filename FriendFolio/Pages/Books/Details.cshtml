@page "{id:int}"
@model Friendfolio.Pages.Books.DetailsModel

@{
    ViewData["Title"] = Model.MemoryBook.Title;
}

<section class="page-header book-header">
    <div class="form-actions mb-3">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Tillbaka till böcker
        </a>

        <a asp-page="./Edit"
           asp-route-id="@Model.MemoryBook.Id"
           class="btn btn-primary">
            Redigera bok
        </a>
    </div>

    <p class="eyebrow">Vänbok</p>
    <h1>@Model.MemoryBook.Title</h1>

    @if (!string.IsNullOrWhiteSpace(Model.MemoryBook.Description))
    {
        <p>@Model.MemoryBook.Description</p>
    }

    <span class="book-meta">
        Skapad @Model.MemoryBook.CreatedAt.ToString("yyyy-MM-dd")
    </span>
    
</section>

<section class="invite-panel">
    <div>
        <p class="eyebrow">Dela boken</p>
        <h2>Delningslänk</h2>
        <p>Skicka länken till personer som ska svara i boken.</p>
    </div>

    <div class="input-group invite-link-group">
        <input value="@Model.InviteUrl"
               id="inviteUrl"
               class="form-control"
               readonly />

        <button type="button"
                class="btn btn-outline-secondary"
                onclick="copyInviteLink()">
            Kopiera
        </button>

        <a href="@Model.InviteUrl"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-outline-secondary">
            Öppna
        </a>
    </div>

    <p id="copyMessage" class="copy-message" hidden>
        Länken är kopierad!
    </p>
</section>

<section class="content-panel">
    <div class="section-heading">
        <p class="eyebrow">Frågor</p>
        <h2>Bokens frågor</h2>
    </div>

    @if (!Model.MemoryBook.Questions.Any())
    {
        <p>Den här boken har inga frågor ännu.</p>
    }
    else
    {
        <ol class="question-list">
            @foreach (var question in Model.MemoryBook.Questions.OrderBy(question => question.SortOrder))
            {
                <li>@question.Text</li>
            }
        </ol>
    }

    <form method="post" asp-page-handler="AddQuestion" class="question-form">
        <div class="mb-3">
            <label asp-for="NewQuestionText" class="form-label">Ny fråga</label>
            <input asp-for="NewQuestionText"
                   class="form-control"
                   placeholder="Till exempel: Vad är ditt bästa minne med mig?" />
        </div>

        <button type="submit" class="btn btn-primary">Lägg till fråga</button>
    </form>
</section>

<section class="content-panel">
    <div class="section-heading">
        <p class="eyebrow">Svar</p>
        <h2>Inskickade uppslag</h2>
    </div>

    @if (!Model.MemoryBook.Entries.Any())
    {
        <p>Ingen har svarat i boken ännu.</p>
    }
    else
    {
        <div class="answer-grid">
            @foreach (var entry in Model.MemoryBook.Entries.OrderByDescending(entry => entry.CreatedAt))
            {
                <article class="memory-entry-card">
                    <div class="memory-entry-header">
                        <div>
                            <p class="eyebrow">Uppslag</p>
                            <h3>@entry.DisplayName</h3>
                            <span class="book-meta">
                                Skickade in @entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </span>
                            <form method="post"
                                  asp-page-handler="DeleteEntry"
                                  asp-route-entryId="@entry.Id"
                                  class="delete-entry-form">
                                <button type="submit"
                                        class="btn btn-outline-secondary btn-sm"
                                        onclick="return confirm('Vill du ta bort det här uppslaget?');">
                                    Ta bort uppslag
                                </button>
                            </form>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(entry.PhotoUrl))
                        {
                            <img src="@entry.PhotoUrl"
                                 alt="Foto från @entry.DisplayName"
                                 class="memory-entry-photo" />
                        }
                        else
                        {
                            <div class="memory-entry-photo-placeholder" aria-hidden="true">
                                <span>Foto</span>
                            </div>
                        }
                    </div>

                    <div class="answer-list">
                        @foreach (var answer in entry.Answers.OrderBy(answer => answer.BookQuestion.SortOrder))
                        {
                            <div class="answer-item">
                                <strong>@answer.BookQuestion.Text</strong>
                                <p>@answer.Text</p>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        async function copyInviteLink() {
            const inviteInput = document.getElementById("inviteUrl");
            const copyMessage = document.getElementById("copyMessage");

            await navigator.clipboard.writeText(inviteInput.value);

            copyMessage.hidden = false;

            setTimeout(() => {
                copyMessage.hidden = true;
            }, 2000);
        }
    </script>
}
