@page
@model Friendfolio.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Skapa bok";
}

<section>
    <h1>Skapa en ny bok</h1>
    <p>Ge boken ett namn och en kort beskrivning. Frågor lägger vi till i nästa steg.</p>
</section>

<form method="post">
    <div class="mb-3">
        <label asp-for="MemoryBook.Title" class="form-label">Titel</label>
        <input asp-for="MemoryBook.Title" class="form-control" />
        <span asp-validation-for="MemoryBook.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MemoryBook.Description" class="form-label">Beskrivning</label>
        <textarea asp-for="MemoryBook.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="MemoryBook.Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Skapa bok</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Avbryt</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}